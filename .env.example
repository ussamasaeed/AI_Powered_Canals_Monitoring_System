LLM_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434

OLLAMA_MODEL=qwen2.5:3b

OLLAMA_TIMEOUT_SECONDS=180

# This we used locally run model if you using open source model or closed source model then add api key.
HF_API_TOKEN=""

# and change the model name to your desired model name from HuggingFace.
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAG_TOP_K=5
